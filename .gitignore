# Локальное окружение Python и кеши инструментов.
.venv/
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Результаты сборки пакета.
build/
dist/
wheels/
*.egg-info

# Локальные настройки и секреты. Образец .env.example хранится в Git.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Служебные файлы редакторов и macOS.
.DS_Store
.idea/
.vscode/

# Rebuild the fictional CSV dataset with python -m app.data.generate.
data/demo*/

# Local reports of the dependency audit and coverage.
reports/
.coverage
.coverage.*
coverage.xml
htmlcov/
