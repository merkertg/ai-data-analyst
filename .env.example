# Образец локальных настроек. Скопируй файл в .env и меняй значения там:
# .env не попадает в Git. Значения ниже годятся только для локальной разработки.

# Название сервиса на странице /docs (поле app_name в app/config.py).
APP_NAME="AI Data Analyst"

# PostgreSQL в Docker Compose (сервис db). Не используй этот пароль на сервере.
POSTGRES_USER=analyst
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=industrialflow
POSTGRES_PORT=5436

# Compose passes raw connection components to migrate/bootstrap/api. Quote a
# password containing special characters; @ / # % need no manual URL encoding.
# The UI receives no database credentials. DATABASE_URL below is for host runs
# and is not forwarded by Compose into the application containers.
# Адрес для приложения и Alembic на этом компьютере: порт опубликован на 127.0.0.1.
# Драйвер postgresql+psycopg — это psycopg 3.
DATABASE_URL=postgresql+psycopg://analyst:local-development-only@127.0.0.1:5436/industrialflow

# An explicit DATABASE_URL takes priority over all separate components.
# For a hand-written URL, percent-encode reserved username/password characters:
# @ -> %40, / -> %2F, # -> %23, % -> %25. Keep PostgreSQL's password raw above.
# Alternative for host runs: comment out DATABASE_URL and set ALL four values
# host/name/user/password. DATABASE_PORT defaults to 5432; use the published
# host port (normally 5436) here. DATABASE_PASSWORD is raw, not URL-encoded.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5436
# DATABASE_NAME=industrialflow
# DATABASE_USER=analyst
# DATABASE_PASSWORD='local-development-only'

# Порт одноразовой тестовой БД (docker compose --profile test up db-test).
# Её адрес тесты получают только из TEST_DATABASE_URL, а не из этого файла.
POSTGRES_TEST_PORT=5437

# AI-аналитик (этап 07). mock — демонстрационный режим без ключа и сети:
# инструменты и проверка доказательств настоящие, языковая модель не вызывается.
LLM_PROVIDER=mock
# Для OpenAI: LLM_PROVIDER=openai, свой ключ и явно выбранная модель.
# Ключ храни только в .env (файл не попадает в Git) и никогда не коммить.
OPENAI_API_KEY=
OPENAI_MODEL=
# Ограничения одного запуска: секунды на запрос к модели, токены ответа,
# шаги модели, вызовы инструментов, исправления отчёта и общее время.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4000
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_CORRECTIONS=2
AGENT_TIMEOUT_SECONDS=120

# Stage 08 UI talks to the local API; it never needs a DB or an OpenAI key.
UI_API_URL=http://127.0.0.1:8000
# Socket waiting timeout; a timed-out POST may still finish on the API server.
UI_REQUEST_TIMEOUT_SECONDS=150

# Доступ к /api (этап 09): токен выдаёт `uv run python -m app.security issue`.
# Интерфейс отправляет его в заголовке Authorization. Не коммить настоящий токен.
UI_API_TOKEN=
# Защита базы и бюджета модели: тайм-аут любого SQL-запроса и лимиты частоты
# на один токен (запуски агента и сохранения отчётов в минуту).
DATABASE_STATEMENT_TIMEOUT_MS=15000
AGENT_RUNS_PER_MINUTE=6
REPORTS_PER_MINUTE=30
